# ============================================
# Python
# ============================================
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ============================================
# Lumina Build Artifacts
# ============================================
*.ll
*.wasm
*.o
.lumina_cache/
output.ll

# ============================================
# Binários nativos gerados
# Padrão geral: ignora tudo em examples/ e tests/
# que não seja código fonte (.lm) ou doc (.md)
# ============================================
/examples/*
!/examples/*.lm
!/examples/*.md
!/examples/MeuBanco/

/tests/*
!/tests/*.lm
!/tests/*.py
!/tests/*.md

# Binários específicos da raiz
/main
/tests_lumina

# ============================================
# Benchmarks (binários compilados + runtime)
# ============================================
/benchmarks/*
!/benchmarks/*.lm
!/benchmarks/*.c
!/benchmarks/*.cpp
!/benchmarks/*.rs
!/benchmarks/*.go
!/benchmarks/*.js
!/benchmarks/*.py
!/benchmarks/*.md

# ============================================
# lumina_core (bootstrapping) - ignora binários
# ============================================
/lumina_core/*
!/lumina_core/*.lm

# ============================================
# Dados de teste temporários
# ============================================
lumina_db.txt
teste_async.txt
log.txt
*.txt
!requirements-dev.txt

# ============================================
# Dependências baixadas
# ============================================
lumina_modules/

# ============================================
# Extensão VS Code
# ============================================
lumina-vscode/node_modules/
lumina-vscode/*.vsix

# ============================================
# Configurações locais / IDE
# ============================================
.vscode/
.idea/
*.swp
*~

# ============================================
# Cache de outros compiladores
# ============================================
*.gcda
*.gcno