# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ============================================
# Lumina: artefatos de build
# ============================================
*.ll
*.wasm
*.o
.lumina_cache/
*.profraw
*.profdata
lumina_test_bin
lumina_test_runner.ll

# ============================================
# examples/ — rastreia só fontes e config
# ============================================
/examples/*
!/examples/*.lm
!/examples/*.md
!/examples/*.toml
!/examples/*.cpp
!/examples/*.h
!/examples/*.expected
!/examples/MeuBanco/

# ============================================
# benchmarks/ — rastreia só fontes, scripts, e resultados
# ============================================
/benchmarks/*
!/benchmarks/*.lm
!/benchmarks/*.c
!/benchmarks/*.cpp
!/benchmarks/*.rs
!/benchmarks/*.go
!/benchmarks/*.js
!/benchmarks/*.py
!/benchmarks/*.md
!/benchmarks/*.sh
!/benchmarks/*.toml
!/benchmarks/results/
!/benchmarks/results/**

# ============================================
# lumina_core/ — só .lm
# ============================================
/lumina_core/*
!/lumina_core/*.lm

# ============================================
# Logs e dados temporários
# ============================================
log.txt
baseline.txt
pytest_baseline.txt
lumina_db.txt
teste_async.txt
lumina.wal

# ============================================
# Dependências externas
# ============================================
lumina_modules/

# ============================================
# VS Code extension
# ============================================
lumina-vscode/node_modules/
lumina-vscode/*.vsix

# ============================================
# IDE / OS
# ============================================
.vscode/
.idea/
*.swp
*~
.DS_Store

# ============================================
# Coverage de C/C++
# ============================================
*.gcda
*.gcno

# ============================================
# Binários compilados (sem extensão)
# ============================================
/tests/features/uncertain_features
/tests/features/*_bin