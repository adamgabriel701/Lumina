*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ============================================
# Lumina: artefatos de build
# ============================================
*.ll
*.wasm
*.o
.lumina_cache/
*.profraw
*.profdata
lumina_test_bin

# ============================================
# examples/ — rastreia só fontes e config
# ============================================
/examples/*
!/examples/*.lm
!/examples/*.md
!/examples/*.toml
!/examples/*.cpp
!/examples/*.h
!/examples/MeuBanco/

# ============================================
# benchmarks/ — rastreia só fontes
# ============================================
/benchmarks/*
!/benchmarks/*.lm
!/benchmarks/*.c
!/benchmarks/*.cpp
!/benchmarks/*.rs
!/benchmarks/*.go
!/benchmarks/*.js
!/benchmarks/*.py
!/benchmarks/*.md

# ============================================
# lumina_core/ — só .lm
# ============================================
/lumina_core/*
!/lumina_core/*.lm

