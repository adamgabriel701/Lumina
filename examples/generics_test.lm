# Função Genérica: identidade, aceita e retorna qualquer tipo
fn identidade<T>(x: T) -> T:
    return x

# Struct Genérica: caixa que guarda um valor T
struct Box<T>:
    data: T

fn main() -> int:
    print("=== identidade<int> ===")
    let a = identidade(42)
    print(a)

    print("=== identidade<float> ===")
    let b = identidade(3.14)
    print(b)

    print("=== Box<int> como variável local ===")
    mut box_i: Box<int>
    box_i.data = 100
    print(box_i.data)

    print("=== Box<float> como variável local ===")
    mut box_f: Box<float>
    box_f.data = 2.71
    print(box_f.data)

    return 0