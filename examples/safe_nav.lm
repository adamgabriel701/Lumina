struct Usuario:
    id: int

fn main() -> int:
    # Cria um usuário válido
    mut u: Usuario
    u.id = 42
    
    # Acesso normal (se u fosse nulo, isso crasharia)
    let id1 = u.id
    print("ID normal:", id1)
    
    # Acesso seguro (?.). Como 'u' não é nulo, retorna o ID (42).
    let id2 = u?.id
    print("ID seguro (u?.id):", id2)
    
    # NOVO: Declara um ponteiro de Usuario, mas não inicializa (fica nulo na memória)
    mut u_nulo: Usuario
    
    # Tentando acessar um ponteiro nulo.
    # Sem o ?., isso daria Segmentation Fault.
    # Com o ?., ele retorna 0 silenciosamente.
    let id3 = u_nulo?.id
    print("ID seguro (nulo?.id):", id3)
    
    return 0