import "std/vector"

fn main() -> int:
    print("🚀 Testando Array Dinâmico (Vector)...")
    
    # Cria um vector com capacidade 4
    mut v = new()
    
    # Adiciona 10 elementos (vai forçar o realloc a dobrar a capacidade várias vezes)
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5) # Aqui dobra para 8
    push(v, 6)
    push(v, 7)
    push(v, 8)
    push(v, 9) # Aqui dobra para 16
    push(v, 10)
    
    print("Tamanho final:", len(v))
    
    # Lê os valores de volta para provar que a memória não corrompeu
    print("Elemento 0:", get(v, 0))
    print("Elemento 4:", get(v, 4))
    print("Elemento 9:", get(v, 9))
    
    return 0
