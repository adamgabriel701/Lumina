{
  "name": "lumina",
  "displayName": "Lumina Language Support",
  "description": "Syntax highlighting and LSP for the Lumina programming language",
  "version": "0.2.0",
  "publisher": "adam-lumina",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lumina"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "lumina_lsp.py",
    "syntaxes/lumina.tmLanguage.json",
    "language-configuration.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lumina",
        "aliases": [
          "Lumina",
          "lumina"
        ],
        "extensions": [
          ".lm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumina",
        "scopeName": "source.lumina",
        "path": "./syntaxes/lumina.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
