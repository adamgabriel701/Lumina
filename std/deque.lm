## Deque: fila de dupla extremidade com buffer circular.
## Uso:
##   mut d = new_deque()
##   d.push_back(1)
##   d.push_front(0)
##   print(d.pop_front())   # 0
##   print(d.pop_back())    # 1
##
## Limitação: capacidade fixa (DEQUE_INITIAL_CAP). Não cresce
## automaticamente — implementar `grow` fica como TODO.
struct Deque:
    data: ptr
    head: int       # índice do primeiro elemento
    size: int
    cap: int

let DEQUE_INITIAL_CAP = 16

impl Deque:
    ## Retorna o índice físico do elemento lógico `i`.
    ## (i = 0 é o primeiro; i = size-1 é o último)
    fn _phys(i: int) -> int:
        return (self.head + i) & (self.cap - 1)

    ## Adiciona no fim.
    fn push_back(value: int):
        let idx = self._phys(self.size)
        self.data[idx] = value
        self.size += 1

    ## Adiciona no início.
    fn push_front(value: int):
        self.head = (self.head - 1) & (self.cap - 1)
        self.data[self.head] = value
        self.size += 1

    ## Remove e retorna o primeiro elemento. Assume size > 0.
    fn pop_front() -> int:
        let val = self.data[self.head]
        self.head = (self.head + 1) & (self.cap - 1)
        self.size -= 1
        return val

    ## Remove e retorna o último elemento. Assume size > 0.
    fn pop_back() -> int:
        let idx = self._phys(self.size - 1)
        let val = self.data[idx]
        self.size -= 1
        return val

    ## Retorna o elemento na posição lógica `i`. Assume 0 <= i < size.
    fn get(i: int) -> int:
        return self.data[self._phys(i)]

    ## Retorna 1 se está vazio; senão 0.
    fn is_empty() -> int:
        if self.size == 0:
            return 1
        return 0

## Cria um Deque vazio (função livre).
fn new_deque() -> Deque:
    mut d: Deque
    d.cap = DEQUE_INITIAL_CAP
    d.head = 0
    d.size = 0
    d.data = alloc(DEQUE_INITIAL_CAP)
    mut i = 0
    while i < DEQUE_INITIAL_CAP:
        d.data[i] = 0
        i += 1
    return d
