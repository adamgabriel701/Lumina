## Map: hash map de int → int com dois arrays paralelos.
## Uso:
##   mut m = new_map()
##   m.insert(42, 100)
##   print(m.get(42))   # 100
struct Map:
    keys: ptr      # -1 = slot vazio
    values: ptr
    size: int
    cap: int

let MAP_INITIAL_CAP = 16

fn _map_hash(key: int, cap: int) -> int:
    return key & (cap - 1)

impl Map:
    ## Insere ou atualiza um par chave-valor.
    ## Se a chave já existe, atualiza o valor.
    fn insert(key: int, value: int):
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                self.keys[i] = key
                self.values[i] = value
                self.size += 1
                return
            if self.keys[i] == key:
                self.values[i] = value
                return
            i = (i + 1) & (self.cap - 1)
            probes += 1

    ## Busca um valor. Retorna -1 se não achar.
    fn get(key: int) -> int:
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                return -1
            if self.keys[i] == key:
                return self.values[i]
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return -1

    ## Retorna 1 se a chave existe; senão 0.
    fn contains(key: int) -> int:
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                return 0
            if self.keys[i] == key:
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

    ## Remove uma chave. Retorna 1 se removeu; 0 se não achou.
    ## Marca com -2 (tombstone) para não quebrar a cadeia de probes.
    fn remove(key: int) -> int:
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                return 0
            if self.keys[i] == key:
                self.keys[i] = -2
                self.size -= 1
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

## Cria um novo Map vazio (função livre).
fn new_map() -> Map:
    mut m: Map
    m.cap = MAP_INITIAL_CAP
    m.size = 0
    m.keys = alloc(MAP_INITIAL_CAP)
    m.values = alloc(MAP_INITIAL_CAP)
    mut i = 0
    while i < MAP_INITIAL_CAP:
        m.keys[i] = -1
        m.values[i] = 0
        i += 1
    return m