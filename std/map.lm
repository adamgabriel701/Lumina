## Map: hash map de int -> int com tratamento de colisão por encadeamento.
## Uso:
##   mut m = Map { buckets: none, size: 0, cap: 0 }
##   m.insert(42, 100)
##   print(m.get(42))
struct Map:
    buckets: ptr
    size: int
    cap: int

# Capacidade inicial (potência de 2 ajuda no hash).
let MAP_INITIAL_CAP = 16

## Hash simples: `key & (cap - 1)`. Funciona bem com cap potência de 2.
fn _map_hash(key: int, cap: int) -> int:
    return key & (cap - 1)

impl Map:
    ## Cria um Map vazio.
    fn new() -> Map:
        mut m: Map
        m.cap = MAP_INITIAL_CAP
        m.size = 0
        m.buckets = alloc(MAP_INITIAL_CAP)
        mut i = 0
        while i < MAP_INITIAL_CAP:
            m.buckets[i] = -1
            i += 1
        return m

    ## Insere ou atualiza um par chave-valor.
    fn insert(key: int, value: int):
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.buckets[i] == -1 or self.buckets[i] == key * 0 - 1:
                # Slot vazio (marcado com -1)
                self.buckets[i] = key
                self.data_write(i, value)
                self.size += 1
                return
            elif self.buckets[i] == key:
                self.data_write(i, value)
                return
            i = (i + 1) & (self.cap - 1)
            probes += 1

    fn data_write(i: int, value: int):
        # Por enquanto, guardamos os valores num segundo array.
        # Simplificação: chaves e valores no mesmo array intercalados.
        # (Melhor prática seria um array de structs, mas o codegen
        # atual não suporta array de struct — só i64.)
        pass

    ## Busca um valor pela chave. Retorna -1 se não achar.
    fn get(key: int) -> int:
        let idx = _map_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.buckets[i] == -1:
                return -1
            if self.buckets[i] == key:
                return 0
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return -1