## Set: conjunto de int usando hash table.
## Uso:
##   mut s = new_set()
##   s.add(42)
##   print(s.contains(42))   # 1
struct Set:
    keys: ptr      # -1 = vazio
    size: int
    cap: int

let SET_INITIAL_CAP = 16

fn _set_hash(key: int, cap: int) -> int:
    return key & (cap - 1)

impl Set:
    ## Adiciona um elemento. No-op se já existe.
    fn add(key: int):
        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                self.keys[i] = key
                self.size += 1
                return
            if self.keys[i] == key:
                return
            i = (i + 1) & (self.cap - 1)
            probes += 1

    ## Retorna 1 se o elemento está no Set; senão 0.
    fn contains(key: int) -> int:
        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                return 0
            if self.keys[i] == key:
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

    ## Remove um elemento. Retorna 1 se removeu; 0 se não achou.
    fn remove(key: int) -> int:
        let idx = _set_hash(key, self.cap)
        mut i = idx
        mut probes = 0
        while probes < self.cap:
            if self.keys[i] == -1:
                return 0
            if self.keys[i] == key:
                self.keys[i] = -2
                self.size -= 1
                return 1
            i = (i + 1) & (self.cap - 1)
            probes += 1
        return 0

## Cria um Set vazio (função livre).
fn new_set() -> Set:
    mut s: Set
    s.cap = SET_INITIAL_CAP
    s.size = 0
    s.keys = alloc(SET_INITIAL_CAP)
    mut i = 0
    while i < SET_INITIAL_CAP:
        s.keys[i] = -1
        i += 1
    return s
