## std/sort.lm — Ordenação com e sem comparator.
##
## Uso:
##   import "std/sort"
##
##   mut arr = alloc(5)
##   arr[0] = 5; arr[1] = 2; arr[2] = 8; arr[3] = 1; arr[4] = 9
##
##   sort(arr, 5)                             # ascendente (i64)
##   sort_by(arr, 5, fn(a: int, b: int) -> int: b - a)   # descendente
##
## Limitação: `sort` assume que `arr` é `i64*` (o retorno de `alloc`).
## Para arrays de `u8`, converta antes.

# ---------------------------------------------------------------------
# Comparators
# ---------------------------------------------------------------------

## Comparator padrão: ordem crescente de i64.
fn _cmp_asc(a: int, b: int) -> int:
    return a - b

## Compara dois i64. Retorna < 0 se `a < b`, 0 se iguais, > 0 se `a > b`.
## Wrapper porque closures passadas de fora também usam essa assinatura.

# ---------------------------------------------------------------------
# Insertion sort (estável, pequeno)
# ---------------------------------------------------------------------
fn _insertion_sort(arr: ptr, n: int, cmp: fn):
    mut i = 1
    while i < n:
        let key = arr[i]
        mut j = i - 1
        while j >= 0:
            let aj = arr[j]
            # cmp(aj, key) > 0  →  aj > key, precisa deslocar
            let c = cmp(aj, key)
            if c <= 0:
                break
            arr[j + 1] = aj
            j = j - 1
        arr[j + 1] = key
        i = i + 1

# ---------------------------------------------------------------------
# QuickSort (in-place, Hoare partition)
# ---------------------------------------------------------------------
fn _partition(arr: ptr, low: int, high: int, cmp: fn) -> int:
    let pivot = arr[high]
    mut i = low - 1
    mut j = low
    while j < high:
        let aj = arr[j]
        let c = cmp(aj, pivot)
        if c <= 0:
            i = i + 1
            let tmp = arr[i]
            arr[i] = aj
            arr[j] = tmp
        j = j + 1
    let tmp2 = arr[i + 1]
    arr[i + 1] = pivot
    arr[high] = tmp2
    return i + 1

fn _quicksort_rec(arr: ptr, low: int, high: int, cmp: fn):
    if low >= high:
        return
    let pi = _partition(arr, low, high, cmp)
    _quicksort_rec(arr, low, pi - 1, cmp)
    _quicksort_rec(arr, pi + 1, high, cmp)

# ---------------------------------------------------------------------
# API pública
# ---------------------------------------------------------------------

## Ordena `arr` (i64) em ordem crescente, com insertion sort.
## Para n > 16, usa quicksort. Estável.
fn sort(arr: ptr, n: int):
    if n <= 1:
        return
    if n <= 16:
        _insertion_sort(arr, n, _cmp_asc)
    else:
        _quicksort_rec(arr, 0, n - 1, _cmp_asc)

## Ordena `arr` com um comparator customizado.
## `cmp(a, b)` deve retornar < 0, 0 ou > 0.
fn sort_by(arr: ptr, n: int, cmp: fn):
    if n <= 1:
        return
    if n <= 16:
        _insertion_sort(arr, n, cmp)
    else:
        _quicksort_rec(arr, 0, n - 1, cmp)

## Retorna 1 se `arr` está ordenado (crescente); 0 se não.
fn is_sorted(arr: ptr, n: int) -> int:
    mut i = 1
    while i < n:
        if arr[i - 1] > arr[i]:
            return 0
        i = i + 1
    return 1
