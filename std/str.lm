## Módulo de Strings (std/str)
## Funções utilitárias para manipulação de texto.

## Procura uma substring dentro de uma string. Retorna o índice ou -1 se não encontrar.
fn find(text: str, search: str) -> int:
    let text_len = len(text)
    let search_len = len(search)
    if search_len == 0:
        return 0
    if text_len < search_len:
        return -1
    
    mut i = 0
    while i <= text_len - search_len:
        mut found = 1
        mut j = 0
        while j < search_len:
            if text[i + j] != search[j]:
                found = 0
                break
            j += 1
        
        if found == 1:
            return i
        i += 1
    return -1

## Extrai uma substring a partir de um índice inicial com um tamanho especificado.
fn substr(text: str, start: int, length: int) -> str:
    let text_len = len(text)
    if start >= text_len:
        return ""
    if start + length > text_len:
        length = text_len - start
        
    mut result = ""
    mut i = 0
    while i < length:
        result = result + chr(text[start + i])
        i += 1
    return result