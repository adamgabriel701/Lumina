# std/str.lm - Funções de string escritas na própria Lumina!

# Converte uma string para maiúsculas
fn to_upper(s: str) -> str:
    let length = len(s)
    mut res = ""
    for i in 0..length:
        let c = s[i]
        # Se for letra minúscula (ASCII 97 a 122), subtrai 32 para virar maiúscula
        if c >= 97 and c <= 122:
            res = res + chr(c - 32)
        else:
            res = res + chr(c)
    return res

# Converte uma string para minúsculas
fn to_lower(s: str) -> str:
    let length = len(s)
    mut res = ""
    for i in 0..length:
        let c = s[i]
        # Se for maiúscula (ASCII 65 a 90), soma 32
        if c >= 65 and c <= 90:
            res = res + chr(c + 32)
        else:
            res = res + chr(c)
    return res

# Remove espaços do início e do fim
fn trim(s: str) -> str:
    let length = len(s)
    mut start = 0
    mut end = length - 1
    
    # Encontra o primeiro caractere não-espaço
    while start < length and s[start] == 32:
        start += 1
        
    # Encontra o último caractere não-espaço
    while end >= 0 and s[end] == 32:
        end -= 1
        
    if start > end:
        return ""
    
    # Slice da string (usando nosso novo recurso de slicing!)
    return s[start..end + 1]

# Verifica se termina com um sufixo
fn ends_with(s: str, suffix: str) -> int:
    let s_len = len(s)
    let suf_len = len(suffix)
    
    if suf_len > s_len:
        return 0
        
    # Slice o final da string e compara
    let s_end = s[s_len - suf_len..s_len]
    if s_end == suffix:
        return 1
    return 0

# Divide uma string por um delimitador e retorna um array de strings (como ptr)
fn split(s: str, delimiter: str) -> ptr:
    let length = len(s)
    let d_len = len(delimiter)
    mut result = alloc(100)
    mut res_idx = 0
    mut i = 0
    mut current_word = ""
    
    while i < length:
        let c = s[i]
        
        # Verifica se o caractere atual é o início do delimitador
        if c == delimiter[0] and i + d_len <= length:
            mut is_match = 1
            mut j = 1
            while j < d_len:
                if s[i+j] != delimiter[j]:
                    is_match = 0
                    break
                j += 1
                
            if is_match == 1:
                result[res_idx] = current_word as int
                res_idx += 1
                current_word = ""
                i += d_len
                continue
                
        current_word = current_word + chr(c)
        i += 1
        
    if len(current_word) > 0:
        result[res_idx] = current_word as int
        res_idx += 1
        
    # Marca o fim do array com 0 (null)
    result[res_idx] = 0
    return result

# Junta um array de strings (ponteiros como int) usando um separador
fn join(arr: ptr, delimiter: str) -> str:
    mut res = ""
    mut i = 0
    while arr[i] != 0:
        if len(res) > 0:
            res = res + delimiter
        res = res + (arr[i] as str)
        i += 1
    return res