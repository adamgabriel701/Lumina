import "std/list"

fn main() -> int:
    print("--- Teste Sintaxe Curta (:=) ---")
    x := 10
    y := 20
    x = x + y
    print("x + y =", x)
    
    print("")
    print("--- Teste Escopo de Bloco ---")
    if x == 30:
        let temp = 100
        print("Dentro do if, temp =", temp)
    # Se tentarmos usar 'temp' aqui fora, o compilador deve dar erro de variável não declarada!
    
    print("")
    print("--- Teste Lista Ligada ---")
    mut l = new()
    push(l, 10)
    push(l, 20)
    push(l, 30)
    
    print("Tamanho da lista:", l.size)
    print("Elemento 0:", get(l, 0))
    print("Elemento 1:", get(l, 1))
    print("Elemento 2:", get(l, 2))
    
    return 0
