import "std/str"

# 1. Metaprogramação: @inline
@inline
fn dobrar(x: int) -> int:
    return x * 2

# 2. UFCS: Função livre que recebe a string como primeiro argumento
fn gritar(s: str) -> str:
    return s + "!!!"

# 3. Strict ? e errdefer
enum Result:
    Ok(int)
    Err(int)

fn validar(x: int) -> Result:
    # errdefer só roda se a função retornar erro!
    errdefer print("⚠️ Validação falhou! Limpando recursos...")
    
    if x < 0:
        return Err(1)
    return Ok(x)

fn main() -> int:
    # Testando @inline e UFCS
    let res = 5 |> dobrar
    print("Dobro:", res)
    
    # UFCS em string!
    let g = "Lumina".gritar()
    print(g)
    
    # Testando errdefer e ?
    let r = validar(-10)
    match r:
        case Ok(v): print("Valido:", v)
        case Err(e): print("Erro codigo:", e)
        
    return 0
