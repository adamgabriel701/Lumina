import "std/str"

fn avaliar_dia(dia: int) -> str:
    # Switch com inteiros (Jump Table nativa)
    switch dia:
        case 1:
            return "Domingo"
        case 2:
            return "Segunda"
        case 3:
            return "Terça"
        case 4:
            return "Quarta"
        case 5:
            return "Quinta"
        case 6:
            return "Sexta"
        case 7:
            return "Sábado"
        default:
            return "Inválido"
            
fn main() -> int:
    print("--- Teste Switch Inteiros ---")
    let d = avaliar_dia(3)
    print("Dia 3 é:", d)
    
    print("")
    print("--- Teste Split e Join ---")
    let frase = "Lumina,é,uma,linguagem,rápida"
    let partes = split(frase, ",")
    
    # Itera e imprime as partes
    mut i = 0
    while partes[i] != 0:
        print("Parte", i, ":", partes[i] as str)
        i += 1
        
    # Junta de volta com espaço
    let juntado = join(partes, " ")
    print("Juntado:", juntado)
    
    return 0
