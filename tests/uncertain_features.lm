# ============================================================
# Teste das features incertas
# Rode: python3 -m lumina_cli.main run tests/uncertain_features.lm
# Ou:   python3 run_tests.py
# ============================================================

# --- 1. String Slicing ---
fn test_string_slicing():
    let s = "hello"
    let sub = s[1..4]
    print("1. Slicing:", sub)

# --- 2. Array indexing ---
fn test_array_indexing():
    let arr = [1, 2, 3, 4, 5]
    print("2. Array indexing:")
    print(arr[1])
    print(arr[2])
    print(arr[3])

# --- 2b. Array slicing (real) ---
fn test_array_real_slicing():
    let arr = [10, 20, 30, 40, 50]
    let sub = arr[1..4]
    print("2b. Array slicing:")
    print(sub[0])
    print(sub[1])
    print(sub[2])

# --- 3/4. Pipe ---
fn dobrar(x: int) -> int:
    return x * 2

fn test_pipe():
    let result = 5 |> dobrar
    print("3. Pipe:", result)

fn test_pipe_chain():
    let result = 5 |> dobrar |> dobrar
    print("4. Pipe encadeado:", result)

# --- 5. Safe Navigation (?.) ---
struct Node:
    value: int

fn test_safe_nav():
    let n: Node = none
    let v = n?.value
    print("5. Safe nav:", v)

# --- 6. Propagação (?) ---
fn dividir(a: int, b: int) -> Result:
    if b == 0:
        return Err(1)
    return Ok(a / b)

fn test_propagate_inner() -> Result:
    let x = dividir(10, 2)?
    let y = dividir(20, 4)?
    return Ok(x + y)

fn test_propagate():
    let r = test_propagate_inner()
    match r:
        case Ok(v): print("6. Propagate:", v)
        case Err(e): print("6. Propagate err:", e)

# --- 7. Switch ---
fn test_switch():
    let dia = 2
    switch dia:
        case 1: print("Domingo")
        case 2: print("Segunda")
        default: print("Outro")

# --- 8. Switch em Enum ---
fn test_switch_enum():
    let r = Ok(5)
    switch r:
        case Ok(v): print("Ok:", v)
        case Err(e): print("Err:", e)

# --- 9. Short decl ---
fn test_short_decl():
    x := 42
    print("9. Short decl:", x)

# --- 10. Block scope ---
fn test_block_scope():
    if true:
        let temp = 100
        print("10. Dentro do if:", temp)

# --- 11. Defer ---
fn test_defer():
    print("11. Início")
    defer print("11. Defer executado")
    print("11. Fim")

# --- 12. Assert ---
fn test_assert():
    assert(1 + 1 == 2)
    print("12. Assert OK")

# --- 13. F-string ---
fn test_fstring():
    let nome = "João"
    let idade = 30
    print($"13. Nome: {nome}, Idade: {idade}")

# --- 14. Generics ---
fn identidade<T>(x: T) -> T:
    return x

fn test_generics():
    let a = identidade(10)
    let b = identidade(3.14)
    print("14. Generics int:", a)
    print("14. Generics float:", b)

# --- 15. Nested structs ---
struct Inner:
    v: int

struct Outer:
    inner: Inner

fn test_nested_struct():
    let inner_val = Inner { v: 0 }
    mut o: Outer
    o.inner = inner_val
    o.inner.v = 99
    print("15. Valor profundo:", o.inner.v)

# --- 16. Match guard ---
fn test_match_guard():
    let x = 15
    match x:
        case n if n > 10:
            print("16. Match guard: Grande")
        default:
            print("16. Match guard: Pequeno")

# --- 17. Match enum ---
fn test_match_enum():
    let opt = Some(42)
    match opt:
        case Some(v): print("17. Valor:", v)
        case None: print("17. Vazio")

# --- 18. Enum multi-payload ---
enum Par:
    Dois(int, int)
    Zero

fn test_multi_payload():
    let p = Dois(10, 20)
    match p:
        case Dois(a, b): print("18. Par:", a, b)
        case Zero: print("18. Zero")

# --- 19. Cast ---
fn test_cast():
    let x = 10 as float
    let y = 3.7 as int
    print("19. Cast:", x, y)

# --- 20. Ponteiros ---
fn test_pointers():
    mut x = 42
    let p = &x
    let v = *p
    print("20. Ponteiro:", v)

# --- 21. Lambda inline ---
fn test_lambda():
    let f = fn(x: int) -> int: x * 2
    print("21. Lambda:", f(10))

# --- 22. Lambda com bloco ---
fn test_lambda_block():
    let f = fn(x: int) -> int:
        let y = x + 5
        return y * 2
    print("22. Lambda bloco:", f(10))

# --- 23. Trait default ---
trait Greeter:
    fn greet():
        print("23. Trait default OK")

struct English:
    dummy: int

impl Greeter for English:
    # sem métodos - usa default

fn test_trait_default():
    mut e: English
    e.greet()

# --- 24. Match string ---
fn test_match_string():
    let cmd = "run"
    match cmd:
        "build" => print("24. Comando: build")
        "run" => print("24. Comando: run")
        else => print("24. Comando: desconhecido")

# ============================================================
# Main
# ============================================================
fn main() -> int:
    print("=== Testando features incertas ===")
    print("")

    test_string_slicing()
    test_array_indexing()
    test_array_real_slicing()
    test_pipe()
    test_pipe_chain()
    test_safe_nav()
    test_propagate()
    test_switch()
    test_switch_enum()
    test_short_decl()
    test_block_scope()
    test_defer()
    test_assert()
    test_fstring()
    test_generics()
    test_nested_struct()
    test_match_guard()
    test_match_enum()
    test_multi_payload()
    test_cast()
    test_pointers()
    test_lambda()
    test_lambda_block()
    test_trait_default()
    test_match_string()

    print("")
    print("=== Fim dos testes ===")
    return 0